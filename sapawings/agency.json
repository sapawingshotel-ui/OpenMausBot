  "stages": [
    {
      "id": "research",
      "owner": "research_2",
      "inputs": [
        "owner brief"
      ],
      "outputs": [
        "dated source registry"
      ],
      "gate": "Sources contain date, provenance and confidence; retrieval is evidence only.",
      "on_error": "Retry source retrieval twice; then hold for research."
    },
    {
      "id": "trends",
      "owner": "research_1",
      "inputs": [
        "source registry"
      ],
      "outputs": [
        "ranked trend hypotheses"
      ],
      "gate": "Use comparable observations and mark uncertainty; no guaranteed viral claim.",
      "on_error": "Use documented evergreen fallback; never fabricate trend data."
    },
    {
      "id": "brief",
      "owner": "content_1",
      "inputs": [
        "trends",
        "brand context"
      ],
      "outputs": [
        "content brief"
      ],
      "gate": "One brand, objective, audience, format, CTA and fact set.",
      "on_error": "Return incomplete brief to Chief."
    },
    {
      "id": "script",
      "owner": "content_3",
      "inputs": [
        "content brief"
      ],
      "outputs": [
        "bilingual copy",
        "shot list"
      ],
      "gate": "All claims trace to applicable evidence.",
      "on_error": "Return unsupported claims to research."
    },
    {
      "id": "production",
      "owner": "creative_1",
      "inputs": [
        "copy",
        "reviewed assets"
      ],
      "outputs": [
        "editable source",
        "preview",
        "asset hashes"
      ],
      "gate": "Real imagery, rights record, render inspected; video route uses video_1.",
      "on_error": "Quarantine failed asset; regenerate draft from eligible source."
    },
    {
      "id": "qc",
      "owner": "quality_1",
      "inputs": [
        "preview",
        "sources",
        "rights",
        "revision"
      ],
      "outputs": [
        "fact pass",
        "visual pass",
        "rights pass",
        "revision seal"
      ],
      "gate": "All three QC roles pass same revision; any edit resets QC.",
      "on_error": "Return to named owner with reasons; no downstream scheduling."
    },
    {
      "id": "publishing",
      "owner": "publishing_1",
      "inputs": [
        "sealed revision",
        "calendar",
        "authority"
      ],
      "outputs": [
        "request",
        "receipt",
        "readback"
      ],
      "gate": "Only scoped authority + verified adapter; deduplicate exact brand/task/revision.",
      "on_error": "On timeout reconcile by idempotency key before retry; unknown stays unknown."
    },
    {
      "id": "analytics",
      "owner": "performance_1",
      "inputs": [
        "actual published IDs",
        "dated metrics"
      ],
      "outputs": [
        "measured results"
      ],
      "gate": "Actual publication verified; missing values remain null.",
      "on_error": "Retry read twice; show unavailable metrics without zeros."
    },
    {
      "id": "optimization",
      "owner": "performance_4",
      "inputs": [
        "measured results"
      ],
      "outputs": [
        "next experiment brief"
      ],
      "gate": "Comparable age/window; evidence-backed recommendation, no automatic spend.",
      "on_error": "Insufficient data returns to observation; no fabricated winner."
    }
  ],
